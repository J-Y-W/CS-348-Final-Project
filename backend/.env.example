PORT=5000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Set this to your deployed frontend URL in production (e.g. https://your-app.vercel.app)
# Leave unset locally to allow all origins.
FRONTEND_URL=

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Seeds one admin account on server startup (only if it doesn't already exist).
# This is the account you'll use to sign in and make changes in the demo.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-deploying
